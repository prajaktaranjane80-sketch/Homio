>>         return GitReason.RATE_LIMITED, "Remote rate limit reached; retry later."
>>     if "407" in message or "proxy authentication" in message:
>>         return GitReason.PROXY_AUTH_REQUIRED, "Proxy authentication is required."
>>     if "401" in message or "authentication failed" in message or "invalid username or password" in message:
>>         return GitReason.AUTHENTICATION_FAILED, "Remote authentication failed; verify the configured credential securely."
>>     if "404" in message or "repository not found" in message:
>>         return GitReason.REMOTE_NOT_FOUND, "Remote repository or branch was not found; verify the remote URL and access."
>>     if "403" in message or "permission denied" in message or "write access to repository not granted" in message:
>>         return GitReason.AUTHORIZATION_DENIED, "Remote rejected the operation for insufficient permission."
>>     if "non-fast-forward" in message or "fetch first" in message:
>>         return GitReason.NON_FAST_FORWARD, "Remote branch moved; reconcile the current remote state before retrying."
>>     if "tls" in message or "ssl certificate" in message or "certificate verify failed" in message:
>>         return GitReason.TLS_FAILURE, "TLS verification failed; inspect the trusted certificate configuration."
>>     if (
>>         "timed out" in message
>>         or "timeout" in message
>>         or "could not resolve host" in message
>>         or "connection reset" in message
>>         or "network is unreachable" in message
>>         or "failed to connect" in message

PS D:\Homio\REOS_CONTROL_CENTER> $ErrorActionPreference = 'Stop'
PS D:\Homio\REOS_CONTROL_CENTER> $repo = 'prajaktaranjane80-sketch/Homio'
PS D:\Homio\REOS_CONTROL_CENTER> $headers = @{ 'User-Agent' = 'HOMIO-ReadOnly-Audit' }
PS D:\Homio\REOS_CONTROL_CENTER> $base = '2aac5917b8c6c3e50cc49dab4bdd75e2da4d9127'
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $branch = Invoke-RestMethod `
>>   -Uri "https://api.github.com/repos/$repo/branches/reos-development" `
>>   -Headers $headers
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $compare = Invoke-RestMethod `
>>   -Uri "https://api.github.com/repos/$repo/compare/$base...reos-development" `
>>   -Headers $headers
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $run = Invoke-RestMethod `
>>   -Uri "https://api.github.com/repos/$repo/actions/runs/39975212489" `
>>   -Headers $headers
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $rawState = Invoke-RestMethod `
>>   -Uri "https://api.github.com/repos/$repo/contents/REOS_CONTROL_CENTER/data/state.json?ref=reos-development" `
>>   -Headers $headers
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $stateText = [Text.Encoding]::UTF8.GetString(
>>   [Convert]::FromBase64String(($rawState.content -replace '\s', ''))
>> )
PS D:\Homio\REOS_CONTROL_CENTER> $state = $stateText | ConvertFrom-Json
PS D:\Homio\REOS_CONTROL_CENTER> $gate = $state.gate_plans.PSObject.Properties['CORE-008'].Value

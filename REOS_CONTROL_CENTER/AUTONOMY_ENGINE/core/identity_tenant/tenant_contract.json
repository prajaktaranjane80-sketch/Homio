        "SUSPENDED"
      ],
      "ACTIVE": [
        "DEACTIVATING",
        "RESTRICTED",
        "SUSPENDED"
      ],
      "RESTRICTED": [
        "ACTIVE",
        "DEACTIVATING",
        "SUSPENDED"
      ],
      "SUSPENDED": [
        "ACTIVE",
        "DEACTIVATING",

  "source_of_truth_boundary": {
    "Tenant": "canonical tenant domain record",
    "TenantRegistry": "deterministic tenant lookup and context resolution boundary",
    "TenantContext": "resolved tenant execution context",
    "TenantConfigurationReference": "reference to externally owned tenant configuration",
    "TenantSecurityProfileReference": "reference to externally owned tenant security policy",
    "TenantRegionJurisdictionReference": "canonical region and jurisdiction reference",
    "excluded_from_T02": [
      "memberships",
      "roles",
      "permissions",
      "authorization_decisions",
      "cross_tenant_enforcement",
      "credentials",
      "sessions",
      "audit_storage",

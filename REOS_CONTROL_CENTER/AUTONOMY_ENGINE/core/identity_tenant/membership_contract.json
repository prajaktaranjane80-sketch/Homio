{
  "contract": {
    "name": "REOS Membership, Roles & Permission Model Contract",
    "version": "1.0.0",
    "domain": "CORE-001",
    "subtask": "CORE-001-T03",
    "status": "ACTIVE"
  },
  "entities": {
    "AttributeConstraint": {
      "fields": [
        "attribute_key",
        "operator",
        "expected_values"
      ]
    },
    "RelationshipRequirement": {
      "fields": [
        "relation_type",
        "target_type",
        "target_id",
        "required"
      ]
    },
    "Organization": {
      "fields": [

        "valid_until",
        "revision"
      ]
    },
    "Entitlement": {
      "fields": [
        "entitlement_id",
        "tenant_id",
        "key",
        "display_name",
        "description",
        "permission_ids",
        "scope_ids",
        "relationship_requirements",
        "attribute_constraints",
        "required_assurance",
        "status",
        "valid_from",
        "valid_until",
        "revision"
      ]
    },
    "Role": {
      "fields": [
        "role_id",
        "tenant_id",
        "organization_id",
        "role_kind",
        "key",
        "display_name",
        "description",
        "permission_ids",
        "entitlement_ids",
        "scope_ids",
        "relationship_requirements",
        "attribute_constraints",
        "required_assurance",
        "revision",
        "active"
      ]
    },
    "Membership": {
      "fields": [
        "membership_id",
        "tenant_id",
        "organization_id",
        "identity_id",
        "status",
        "role_ids",
        "entitlement_ids",
        "scope_ids",
        "relationship_ids",

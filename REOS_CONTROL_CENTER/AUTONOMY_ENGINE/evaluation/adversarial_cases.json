{
  "version": "6.0",
  "description": "Deterministic adversarial evaluation cases for AUTONOMY_ENGINE V6.",
  "cases": [
    {
      "case_id": "V6-ADV-001",
      "name": "Duplicate action prevention",
      "category": "idempotency",
      "description": "The same action request must not be treated as two independent executions.",
      "input_data": {
        "action_id": "action-001",
        "request_id": "request-001",
        "repeat": true
      },
      "expected": {
        "duplicate": true,
        "allow_second_execution": false
      },
      "tags": [
        "idempotency",
        "replay"
      ],
      "enabled": true
    },
    {
      "case_id": "V6-ADV-002",
      "name": "Unauthorized execution attempt",
      "category": "security",
      "description": "An action without the required authorization context must be denied.",
      "input_data": {
        "action_id": "action-002",
        "authorization": null,
        "requested_operation": "execute"
      },
      "expected": {
        "authorized": false,
        "allow_execution": false
      },
      "tags": [
        "authorization",
        "default-deny"
      ],
      "enabled": true
    },
    {
      "case_id": "V6-ADV-003",
      "name": "Workspace boundary violation",
      "category": "workspace",
      "description": "An operation targeting a path outside the authorized workspace must be blocked.",
      "input_data": {
        "workspace": "D:\\HOMIO\\REOS_CONTROL_CENTER\\AUTONOMY_ENGINE",
        "target": "D:\\HOMIO\\OUTSIDE_WORKSPACE\\file.txt"
      },
      "expected": {
        "within_workspace": false,
        "allow_write": false
      },
      "tags": [
        "workspace",
        "boundary"
      ],
      "enabled": true
    },
    {
      "case_id": "V6-ADV-004",
      "name": "Loop detection",
      "category": "orchestration",
      "description": "Repeated execution of an identical action sequence must trigger loop protection.",
      "input_data": {
        "sequence": [
          "plan",
          "validate",
          "plan",
          "validate",
          "plan",
          "validate"
        ],
        "repeat_threshold": 3
      },
      "expected": {
        "loop_detected": true,
        "allow_unbounded_repeat": false
      },
      "tags": [
        "loop-detection",
        "orchestration"
      ],
      "enabled": true
    },
    {
      "case_id": "V6-ADV-005",
      "name": "Tampered provenance",
      "category": "integrity",
      "description": "Modified content must not validate against the original provenance digest.",
      "input_data": {
        "original_content": {
          "decision": "approved"
        },
        "modified_content": {
          "decision": "rejected"
        }
      },
      "expected": {
        "provenance_valid": false,
        "tamper_detected": true
      },
      "tags": [
        "provenance",
        "integrity"
      ],
      "enabled": true
    },
    {
      "case_id": "V6-ADV-006",
      "name": "Missing required capability",
      "category": "capability",
      "description": "An agent must not execute an operation for which its capability is not registered.",
      "input_data": {
        "agent_id": "agent-001",
        "requested_capability": "restricted_operation",
        "registered_capabilities": [
          "read_state",
          "propose_action"
        ]
      },
      "expected": {
        "capability_available": false,
        "allow_execution": false
      },
      "tags": [
        "capability",
        "least-privilege"
      ],
      "enabled": true
    },
    {
      "case_id": "V6-ADV-007",

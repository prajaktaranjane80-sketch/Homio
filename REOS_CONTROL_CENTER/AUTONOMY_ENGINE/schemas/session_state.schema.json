{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homio://autonomy-engine/v6/session-state.schema.json",
  "title": "AUTONOMY_ENGINE V6 Session State",
  "description": "Canonical schema for the durable autonomous execution session state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "planning",
        "awaiting_approval",
        "executing",
        "paused",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_action_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_capability_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "step_index": {
      "type": "integer",
      "minimum": 0
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REOS Decision Record",
  "type": "object",
  "required": [
    "decision_id",
    "question",
    "status",
    "basis"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "SUPPORTED",
        "APPROVED",
        "BLOCKED",
        "REJECTED"
      ]
    },
    "basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

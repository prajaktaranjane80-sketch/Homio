{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homio://autonomy-engine/v6/action-proposal.schema.json",
  "title": "AUTONOMY_ENGINE V6 Action Proposal",
  "description": "Canonical validation schema for an autonomous action proposal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "action_type",
    "capability_id",
    "reason",
    "risk_class"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "action_type": {
      "type": "string",
      "minLength": 1
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "low",
        "standard",
        "high",
        "critical"
      ]
    },
    "requires_approval": {
      "type": "boolean"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
PS D:\Homio\REOS_CONTROL_CENTER> function Get-HomioRemoteFile {
>>     param(
>>         [Parameter(Mandatory)][string]$Path,
>>         [string]$Ref = $script:Branch
>>     )
>>
>>     $EncodedPath = (
>>         $Path.Trim("/") -split "/" |
>>         ForEach-Object { [uri]::EscapeDataString($_) }
>>     ) -join "/"
>>
>>     $EncodedRef = [uri]::EscapeDataString($Ref)
>>
>>     Invoke-HomioApi `
>>         -Method GET `
>>         -Endpoint "/repos/$script:Owner/$script:Repo/contents/$EncodedPath?ref=$EncodedRef"
>> }

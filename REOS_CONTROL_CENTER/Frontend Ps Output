=== REMOTE BLOB READ ===
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $blob = gh api "repos/$repo/git/blobs/$blobSha" | ConvertFrom-Json
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> if (-not $blob.content) {
>>     throw "REMOTE BLOB CONTENT MISSING"
>> }
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $content = [Text.Encoding]::UTF8.GetString(
>>     [Convert]::FromBase64String(
>>         ($blob.content -replace "`n","")
>>     )
>> )
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> if ([string]::IsNullOrWhiteSpace($content)) {
>>     throw "REMOTE BLOB DECODED CONTENT EMPTY"
>> }
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "BLOB READ = PASS" -ForegroundColor Green
BLOB READ = PASS
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "BLOB SHA = $($blob.sha)" -ForegroundColor Green
BLOB SHA = 429151a6808e64f951f0d0187d2c144add90d12a
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "CONTENT LENGTH = $($content.Length)" -ForegroundColor Green
CONTENT LENGTH = 1486
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "FIRST LINE = $($content.Split([Environment]::NewLine)[0])" -ForegroundColor Green
FIRST LINE = import type { Metadata } from "next";
PS D:\Homio\REOS_CONTROL_CENTER>

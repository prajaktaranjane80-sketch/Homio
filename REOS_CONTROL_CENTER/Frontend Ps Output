PS D:\Homio\REOS_CONTROL_CENTER> $repo="prajaktaranjane80-sketch/Homio"
PS D:\Homio\REOS_CONTROL_CENTER> $branch="reos-development"
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "=== BRANCH HEAD ===" -ForegroundColor Cyan
=== BRANCH HEAD ===
PS D:\Homio\REOS_CONTROL_CENTER> $head = gh api "repos/$repo/git/ref/heads/$branch" --jq ".object.sha"
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> if ([string]::IsNullOrWhiteSpace($head)) {
>>     throw "HEAD SHA EMPTY"
>> }
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "HEAD = $head" -ForegroundColor Green
HEAD = 931efd7a40dbd1e45e3ff648507746aa891f13a0
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "`n=== COMMIT TREE SHA ===" -ForegroundColor Cyan

=== COMMIT TREE SHA ===
PS D:\Homio\REOS_CONTROL_CENTER> $treeSha = gh api "repos/$repo/git/commits/$head" --jq ".tree.sha"
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> if ([string]::IsNullOrWhiteSpace($treeSha)) {
>>     throw "TREE SHA EMPTY"
>> }
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "TREE SHA = $treeSha" -ForegroundColor Green
TREE SHA = ea071037f4c191526a0952af51d97796e0878177
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "`n=== DIRECT TREE API ===" -ForegroundColor Cyan

=== DIRECT TREE API ===
PS D:\Homio\REOS_CONTROL_CENTER> $treeCheck = gh api "repos/$repo/git/trees/$treeSha" --jq "{sha:.sha, entries:(.tree | length), truncated:.truncated}"
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> if ([string]::IsNullOrWhiteSpace($treeCheck)) {
>>     throw "TREE API RETURNED EMPTY"
>> }
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "TREE API = $treeCheck" -ForegroundColor Green
TREE API = {"entries":5,"sha":"ea071037f4c191526a0952af51d97796e0878177","truncated":false}
PS D:\Homio\REOS_CONTROL_CENTER>

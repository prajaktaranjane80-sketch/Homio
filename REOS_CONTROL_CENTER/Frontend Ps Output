Function
PS D:\Homio\REOS_CONTROL_CENTER> (Get-Command Get-RemoteFile -ErrorAction Stop).Definition

    param(
        [Parameter(Mandatory = $true)]
        [string]$Path
    )

    $repo  = "prajaktaranjane80-sketch/Homio"
    $branch = "reos-development"

    $encodedPath = (($Path -split "/") | ForEach-Object {
        [System.Uri]::EscapeDataString($_)
    }) -join "/"

    $token = gh auth token
    if ([string]::IsNullOrWhiteSpace($token)) {
        throw "GITHUB AUTH TOKEN NOT AVAILABLE"
    }

    $headers = @{
        Authorization = "Bearer $token"
        Accept        = "application/vnd.github+json"
        "X-GitHub-Api-Version" = "2022-11-28"
    }

    $uri = "https://api.github.com/repos/$repo/contents/$encodedPath?ref=$branch"

    try {
        return Invoke-RestMethod `
            -Uri $uri `
            -Headers $headers `
            -Method Get `
            -ErrorAction Stop
    }
    catch {
        $status = $null

        if ($_.Exception.Response) {
            try {
                $status = [int]$_.Exception.Response.StatusCode
            } catch {}
        }

        if ($status -eq 404) {
            return $null
        }

        throw "REMOTE FILE READ FAILED: $Path | HTTP $status | $($_.Exception.Message)"
    }


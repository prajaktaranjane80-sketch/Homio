PS D:\Homio\REOS_CONTROL_CENTER> $headers = @{
>>     Accept = "application/vnd.github+json"
>> }
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "=== BRANCH HEAD ===" -ForegroundColor Cyan
=== BRANCH HEAD ===
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $branchUri = "https://api.github.com/repos/$repo/branches/$branch"
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $b = Invoke-RestMethod `
>>     -Uri $branchUri `
>>     -Headers $headers `
>>     -Method Get `
>>     -ErrorAction Stop
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $head = $b.commit.sha
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "HEAD = $head" -ForegroundColor Green
HEAD = 3fa05baec18092fa193f2f2c96d29a361715499a
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "`n=== COMMIT TREE ===" -ForegroundColor Cyan

=== COMMIT TREE ===
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $commitUri = "https://api.github.com/repos/$repo/git/commits/$head"
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $c = Invoke-RestMethod `
>>     -Uri $commitUri `
>>     -Headers $headers `
>>     -Method Get `
>>     -ErrorAction Stop
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $treeSha = $c.tree.sha
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> if ([string]::IsNullOrWhiteSpace($treeSha)) {
>>     throw "TREE SHA EMPTY"
>> }
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "TREE SHA = $treeSha" -ForegroundColor Green
TREE SHA = 0046c42dfdbab209e8482942618102b1e1819141
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "`n=== TREE READ ===" -ForegroundColor Cyan

=== TREE READ ===
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $treeUri = "https://api.github.com/repos/$repo/git/trees/$treeSha"
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> $t = Invoke-RestMethod `
>>     -Uri $treeUri `
>>     -Headers $headers `
>>     -Method Get `
>>     -ErrorAction Stop
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> if ($null -eq $t.tree) {
>>     throw "TREE ARRAY MISSING"
>> }
PS D:\Homio\REOS_CONTROL_CENTER>
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "TREE READ = PASS" -ForegroundColor Green
TREE READ = PASS
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "TREE ENTRIES = $($t.tree.Count)" -ForegroundColor Green
TREE ENTRIES = 5
PS D:\Homio\REOS_CONTROL_CENTER> Write-Host "TREE TRUNCATED = $($t.truncated)" -ForegroundColor Green
TREE TRUNCATED = False
PS D:\Homio\REOS_CONTROL_CENTER>

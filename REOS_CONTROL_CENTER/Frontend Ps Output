PS D:\Homio\REOS_CONTROL_CENTER\Frontend> function Get-GitBlobSha1 {
>>     param([Parameter(Mandatory)][string]$FilePath)
>>
>>     $bytes = [System.IO.File]::ReadAllBytes($FilePath)
>>     $header = [System.Text.Encoding]::ASCII.GetBytes(
>>         "blob $($bytes.Length)`0"
>>     )
>>     $payload = New-Object byte[] ($header.Length + $bytes.Length)
>>
>>     [System.Buffer]::BlockCopy(
>>         $header, 0, $payload, 0, $header.Length
>>     )
>>     [System.Buffer]::BlockCopy(
>>         $bytes, 0, $payload, $header.Length, $bytes.Length
>>     )
>>
>>     $sha1 = [System.Security.Cryptography.SHA1]::Create()
>>     try {
>>         return ([BitConverter]::ToString(
>>             $sha1.ComputeHash($payload)
>>         )).Replace("-", "").ToLowerInvariant()
>>     }
>>     finally {
>>         $sha1.Dispose()
>>     }
>> }


{
  "name": "homio-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "HOMIO production frontend experience layer over REOS.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:lockfile": "node ./scripts/verify-lockfile.mjs",
    "verify:design-system": "node ./scripts/verify-design-system.mjs",
    "verify:foundation": "npm run verify:lockfile && node ./scripts/verify-foundation.mjs && npm run verify:design-system",
    "verify:auth": "node --test ./scripts/auth-runtime.test.mjs && node ./scripts/verify-auth.mjs",
    "verify:f02": "node ./scripts/verify-f02.mjs",
    "verify:f03": "node ./scripts/verify-f03.mjs",
    "verify:f04": "node ./scripts/verify-f04.mjs",
    "verify:f05": "node ./scripts/verify-f05.mjs",
    "verify:f06": "node ./scripts/verify-f06.mjs",
    "verify:f07": "node ./scripts/verify-f07.mjs",
    "verify:f08": "node ./scripts/verify-f08.mjs",
    "verify:f09": "node ./scripts/verify-f09.mjs",
    "verify:f10": "node ./scripts/verify-f10.mjs",
    "verify:f11": "node ./scripts/verify-f11.mjs",
    "verify:f12": "node ./scripts/verify-f12.mjs",
    "verify:f13": "node ./scripts/verify-f13.mjs",
    "verify": "npm run verify:foundation && npm run verify:auth && npm run verify:f02 && npm run verify:f03 && npm run verify:f04 && npm run verify:f05 && npm run verify:f06 && npm run verify:f07 && npm run verify:f08 && npm run verify:f09 && npm run verify:f10 && npm run verify:f11 && npm run verify:f12 && npm run verify:f13 && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "typescript": "6.0.3"
  }
}

NODE_ENV=development

HOMIO_BACKEND_HOST=127.0.0.1
HOMIO_BACKEND_PORT=3001

HOMIO_LOG_LEVEL=info

HOMIO_REQUEST_TIMEOUT_MS=30000
HOMIO_SHUTDOWN_TIMEOUT_MS=10000

# Configure these in the deployment environment, not in committed secrets.
# The application and migration URLs must target the same database.
#
# HOMIO_POSTGRES_URL=postgresql://homio_api:REPLACE_ME@db-host:5432/homio
# HOMIO_POSTGRES_MIGRATION_URL=postgresql://homio_migrator:REPLACE_ME@db-host:5432/homio
#
# HOMIO_APPLICATION_ROLE=homio_api
# HOMIO_MIGRATION_ROLE=homio_migrator
#
# Production requires verify-full TLS.
# HOMIO_POSTGRES_SSL_MODE=verify-full
# HOMIO_POSTGRES_CA_CERT=-----BEGIN CERTIFICATE-----...
#
# Local disposable development only:
# HOMIO_POSTGRES_SSL_MODE=disable

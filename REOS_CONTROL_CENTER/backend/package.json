
{
  "name": "homio-reos-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Unified public Fastify API foundation for HOMIO / REOS.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:build-reproducibility": "node scripts/verify-build-reproducibility.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run verify:build-reproducibility"
  },
  "dependencies": {
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.1.0"
  }
}

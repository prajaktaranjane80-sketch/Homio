Write-Host "=== T03 FIXTURE DEFINITIONS ==="

$i=1
(Get-Content "AUTONOMY_ENGINE\core\trust_fraud_governance\test_core007_t03_risk_rules.py") |
ForEach-Object {
    if ($_ -match '^\s*def (context|make_fraud_assessment|make_finding)\(' -or
        $_ -match '^\s*def test_') {
        "{0}: {1}" -f $i,$_
    }
    $i++
}

Write-Host ""
Write-Host "=== T03 FIXTURE CONTEXT ==="

$lines=Get-Content "AUTONOMY_ENGINE\core\trust_fraud_governance\test_core007_t03_risk_rules.py"

$matches=Select-String -Path "AUTONOMY_ENGINE\core\trust_fraud_governance\test_core007_t03_risk_rules.py" `
    -Pattern "def context\(|def make_fraud_assessment\(|tenant_id=|subject_id="

foreach ($m in $matches) {
    $start=[Math]::Max(1,$m.LineNumber-5)
    $end=[Math]::Min($lines.Count,$m.LineNumber+18)
    Write-Host ""
    Write-Host "--- lines $start-$end ---"
    for($n=$start;$n -le $end;$n++) {
        "{0}: {1}" -f $n,$lines[$n-1]
    }
}

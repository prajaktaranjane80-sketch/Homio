RISK_RULE_SCHEMA_VERSION = 1
RISK_RULE_MODEL_VERSION = "1.0"


class RiskRuleError(Exception):
    """Base CORE-007 risk-rule error."""


class RiskRuleValidationError(RiskRuleError):
    """Invalid risk-rule input."""


class RiskRuleScopeError(RiskRuleError):
    """Cross-tenant or subject-scope violation."""


class RiskRuleConflictError(RiskRuleError):
    """Conflicting risk-assessment identity."""


class RiskLevel(IntEnum):
    LOW = 0
    MEDIUM = 1
    HIGH = 2
    CRITICAL = 3


class RiskRuleKind(str, Enum):
    TRUST_SCORE_AT_MOST = "TRUST_SCORE_AT_MOST"
    FRAUD_TRIPWIRE = "FRAUD_TRIPWIRE"
    FRAUD_SEVERITY_AT_LEAST = "FRAUD_SEVERITY_AT_LEAST"
    FRAUD_FINDING_CODE = "FRAUD_FINDING_CODE"


def _text(value: str, field_name: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise RiskRuleValidationError(
            f"{field_name} must be non-empty text"
        )
    return value.strip()


def _uuid(value: UUID, field_name: str) -> UUID:
    if not isinstance(value, UUID):
        raise RiskRuleValidationError(
            f"{field_name} must be UUID"
        )
    return value


def _time(value: datetime, field_name: str) -> datetime:
    if not isinstance(value, datetime):
        raise RiskRuleValidationError(
            f"{field_name} must be datetime"
        )

    if value.tzinfo is None or value.utcoffset() is None:
        raise RiskRuleValidationError(
            f"{field_name} must be timezone-aware"
        )

    return value.astimezone(timezone.utc)


def _references(values: tuple[str, ...]) -> tuple[str, ...]:
    if not values:
        raise RiskRuleValidationError(
            "evidence_references must not be empty"
        )

    normalized = tuple(
        dict.fromkeys(
            _text(value, "evidence_reference")
            for value in values
        )
    )

    if not normalized:
        raise RiskRuleValidationError(
            "evidence_references must not be empty"
        )

    return normalized


def _fingerprint(payload: object) -> str:
    canonical = json.dumps(
        payload,
        sort_keys=True,
        separators=(",", ":"),
        default=str,
    )
    return hashlib.sha256(
        canonical.encode("utf-8")
    ).hexdigest()


def _fraud_severity_rank(
    severity: FraudSeverity,
) -> int:
    return {
        FraudSeverity.INFORMATIONAL: 0,
        FraudSeverity.REVIEW: 1,
        FraudSeverity.HIGH: 2,
        FraudSeverity.CRITICAL: 3,
    }[severity]


def _score_level(score: int) -> RiskLevel:
    if score >= 90:
        return RiskLevel.CRITICAL
    if score >= 60:
        return RiskLevel.HIGH
    if score >= 30:
        return RiskLevel.MEDIUM
    return RiskLevel.LOW


@dataclass(frozen=True, slots=True)
class RiskRule:
    """Immutable deterministic business-risk rule."""

    rule_id: str
    version: str
    kind: RiskRuleKind
    level: RiskLevel
    score_weight: int
    threshold: int | None = None
    fraud_severity: FraudSeverity | None = None
    finding_code: FraudFindingCode | None = None
    enabled: bool = True
    description: str = ""

    def __post_init__(self) -> None:
        object.__setattr__(
            self,
            "rule_id",
            _text(self.rule_id, "rule_id"),
        )
        object.__setattr__(
            self,
            "version",
            _text(self.version, "version"),
        )

        if not isinstance(
            self.kind,
            RiskRuleKind,
        ):
            raise RiskRuleValidationError(
                "kind must be RiskRuleKind"
            )

        if not isinstance(
            self.level,
            RiskLevel,
        ):
            raise RiskRuleValidationError(
                "level must be RiskLevel"
            )

        if (
            isinstance(self.score_weight, bool)
            or not isinstance(self.score_weight, int)
            or self.score_weight < 0
        ):
            raise RiskRuleValidationError(
                "score_weight must be integer >= 0"
            )

        if self.threshold is not None:
            if (
                isinstance(self.threshold, bool)
                or not isinstance(self.threshold, int)
                or not 0 <= self.threshold <= 100
            ):
                raise RiskRuleValidationError(
                    "threshold must be integer between 0 and 100"
                )

        if self.fraud_severity is not None and not isinstance(
            self.fraud_severity,
            FraudSeverity,
        ):
            raise RiskRuleValidationError(
                "fraud_severity must be FraudSeverity"
            )

        if self.finding_code is not None and not isinstance(
            self.finding_code,
            FraudFindingCode,
        ):
            raise RiskRuleValidationError(
                "finding_code must be FraudFindingCode"
            )

        object.__setattr__(
            self,
            "description",
            (
                self.description.strip()
                if isinstance(self.description, str)
                else ""
            ),
        )

        self._validate_parameters()

    def _validate_parameters(self) -> None:
        if self.kind == RiskRuleKind.TRUST_SCORE_AT_MOST:
            if self.threshold is None:
                raise RiskRuleValidationError(
                    "TRUST_SCORE_AT_MOST requires threshold"
                )

        if self.kind == RiskRuleKind.FRAUD_SEVERITY_AT_LEAST:
            if self.fraud_severity is None:
                raise RiskRuleValidationError(
                    "FRAUD_SEVERITY_AT_LEAST requires fraud_severity"
                )

        if self.kind == RiskRuleKind.FRAUD_FINDING_CODE:
            if self.finding_code is None:
                raise RiskRuleValidationError(
                    "FRAUD_FINDING_CODE requires finding_code"
                )

        if self.kind == RiskRuleKind.FRAUD_TRIPWIRE:
            if (
                self.threshold is not None
                or self.fraud_severity is not None
                or self.finding_code is not None
            ):
                raise RiskRuleValidationError(
                    "FRAUD_TRIPWIRE does not accept rule parameters"
                )

    @property
    def fingerprint(self) -> str:
        return _fingerprint(
            {
                "rule_id": self.rule_id,
                "version": self.version,
                "kind": self.kind.value,
                "level": self.level.name,
                "score_weight": self.score_weight,
                "threshold": self.threshold,
                "fraud_severity": (
                    self.fraud_severity.value
                    if self.fraud_severity
                    else None
                ),
                "finding_code": (
                    self.finding_code.value
                    if self.finding_code
                    else None
                ),
                "enabled": self.enabled,
                "description": self.description,
            }
        )

    def matches(
        self,
        context: "RiskEvaluationContext",
    ) -> tuple[bool, tuple[str, ...]]:
        """Return (matched, evidence references)."""

        if not self.enabled:
            return False, ()

        if self.kind == RiskRuleKind.TRUST_SCORE_AT_MOST:
            if context.trust_score is None:
                return False, ()

            score = context.trust_score.score

            if score <= self.threshold:
                return True, (
                    f"trust-score:{context.trust_score.model_fingerprint}",
                )

            return False, ()

        if self.kind == RiskRuleKind.FRAUD_TRIPWIRE:
            if context.fraud_assessment is None:
                return False, ()

            if not context.fraud_assessment.tripwire_raised:
                return False, ()

            references = []
            for finding in context.fraud_assessment.findings:
                references.extend(
                    finding.evidence_references
                )

            return True, tuple(
                dict.fromkeys(references)
            )

        if self.kind == RiskRuleKind.FRAUD_SEVERITY_AT_LEAST:
            if context.fraud_assessment is None:
                return False, ()

            minimum = _fraud_severity_rank(
                self.fraud_severity
            )

            references: list[str] = []

            for finding in context.fraud_assessment.findings:
                if _fraud_severity_rank(
                    finding.severity
                ) >= minimum:
                    references.extend(
                        finding.evidence_references
                    )

            if references:
                return True, tuple(
                    dict.fromkeys(references)
                )

            return False, ()

        if self.kind == RiskRuleKind.FRAUD_FINDING_CODE:
            if context.fraud_assessment is None:
                return False, ()

            references: list[str] = []

            for finding in context.fraud_assessment.findings:
                if finding.code == self.finding_code:
                    references.extend(
                        finding.evidence_references
                    )

            if references:
                return True, tuple(
                    dict.fromkeys(references)
                )

            return False, ()

        raise RiskRuleValidationError(
            f"Unsupported rule kind: {self.kind}"
        )

    def to_dict(self) -> dict[str, object]:
        return {
            "rule_id": self.rule_id,
            "version": self.version,
            "kind": self.kind.value,
            "level": self.level.name,
            "score_weight": self.score_weight,
            "threshold": self.threshold,
            "fraud_severity": (
                self.fraud_severity.value
                if self.fraud_severity
                else None
            ),
            "finding_code": (
                self.finding_code.value
                if self.finding_code
                else None
            ),
            "enabled": self.enabled,
            "description": self.description,
            "fingerprint": self.fingerprint,
        }


@dataclass(frozen=True, slots=True)
class RiskRuleSet:
    """Versioned immutable rule registry."""

    version: str
    rules: tuple[RiskRule, ...]

    def __post_init__(self) -> None:
        object.__setattr__(
            self,
            "version",
            _text(self.version, "version"),
        )

        if not isinstance(self.rules, tuple):
            raise RiskRuleValidationError(
                "rules must be tuple"
            )

        identities: set[str] = set()

        for rule in self.rules:
            if not isinstance(rule, RiskRule):
                raise RiskRuleValidationError(
                    "rules must contain RiskRule"
                )

            if rule.rule_id in identities:
                raise RiskRuleValidationError(
                    f"Duplicate risk rule: {rule.rule_id}"
                )

            identities.add(rule.rule_id)

    @classmethod
    def default(cls) -> "RiskRuleSet":
        return cls(
            version="1.0",
            rules=(
                RiskRule(
                    rule_id="RISK-TRUST-LOW",
                    version="1.0",
                    kind=RiskRuleKind.TRUST_SCORE_AT_MOST,
                    level=RiskLevel.HIGH,
                    score_weight=60,
                    threshold=40,
                    description=(
                        "Low trust score creates elevated business risk."
                    ),
                ),
                RiskRule(
                    rule_id="RISK-FRAUD-TRIPWIRE",
                    version="1.0",
                    kind=RiskRuleKind.FRAUD_TRIPWIRE,
                    level=RiskLevel.CRITICAL,
                    score_weight=100,
                    description=(
                        "Fraud tripwire evidence creates critical risk."
                    ),
                ),
                RiskRule(
                    rule_id="RISK-FRAUD-HIGH",
                    version="1.0",
                    kind=RiskRuleKind.FRAUD_SEVERITY_AT_LEAST,
                    level=RiskLevel.HIGH,
                    score_weight=70,
                    fraud_severity=FraudSeverity.HIGH,
                    description=(
                        "High or critical fraud findings create "
                        "elevated business risk."
                    ),
                ),
                RiskRule(
                    rule_id="RISK-EVIDENCE-CONFLICT",
                    version="1.0",
                    kind=RiskRuleKind.FRAUD_FINDING_CODE,
                    level=RiskLevel.CRITICAL,
                    score_weight=90,
                    finding_code=(
                        FraudFindingCode.HANDOFF_EVIDENCE_CONFLICT
                    ),
                    description=(
                        "Conflicting evidence requires critical review."
                    ),
                ),
            ),
        )

    @property
    def fingerprint(self) -> str:
        return _fingerprint(
            {
                "version": self.version,
                "rules": tuple(
                    rule.fingerprint
                    for rule in sorted(
                        self.rules,
                        key=lambda item: item.rule_id,
                    )
                    if rule.enabled
                ),
            }
        )

    def to_dict(self) -> dict[str, object]:
        return {
            "version": self.version,
            "rules": [
                rule.to_dict()
                for rule in sorted(
                    self.rules,
                    key=lambda item: item.rule_id,
                )
            ],
            "fingerprint": self.fingerprint,
        }


@dataclass(frozen=True, slots=True)
class RiskEvaluationContext:
    """Tenant-scoped inputs for business-risk evaluation."""

    tenant_id: str
    subject_id: str
    action_id: str
    trust_score: TrustScore | None = None
    fraud_assessment: FraudAssessment | None = None

    def __post_init__(self) -> None:
        object.__setattr__(
            self,
            "tenant_id",
            _text(self.tenant_id, "tenant_id"),
        )
        object.__setattr__(
            self,
            "subject_id",
            _text(self.subject_id, "subject_id"),
        )
        object.__setattr__(
            self,
            "action_id",
            _text(self.action_id, "action_id"),
        )

        if self.trust_score is not None:
            if not isinstance(
                self.trust_score,
                TrustScore,
            ):
                raise RiskRuleValidationError(
                    "trust_score must be TrustScore"
                )

            if self.trust_score.source_of_truth != "trust_score":
                raise RiskRuleValidationError(
                    "Invalid TrustScore source_of_truth"
                )

            self.trust_score.assert_scope(
                tenant_id=self.tenant_id,
                subject_id=self.subject_id,
            )

        if self.fraud_assessment is not None:
            if not isinstance(
                self.fraud_assessment,
                FraudAssessment,
            ):
                raise RiskRuleValidationError(
                    "fraud_assessment must be FraudAssessment"
                )

            if (
                self.fraud_assessment.source_of_truth
                != "fraud_detection"
            ):
                raise RiskRuleValidationError(
                    "Invalid FraudAssessment source_of_truth"
                )

            if (
                str(self.fraud_assessment.tenant_id)
                != str(self.tenant_id)
                or str(self.fraud_assessment.subject_id)
                != str(self.subject_id)
            ):
                raise RiskRuleScopeError(
                    "FraudAssessment crosses tenant or subject scope"
                )

    @property
    def input_fingerprint(self) -> str:
        return _fingerprint(
            {
                "tenant_id": self.tenant_id,
                "subject_id": self.subject_id,
                "action_id": self.action_id,
                "trust_score": (
                    self.trust_score.to_dict()
                    if self.trust_score
                    else None
                ),
                "fraud_assessment": (
                    self.fraud_assessment.to_dict()
                    if self.fraud_assessment
                    else None
                ),
            }
        )



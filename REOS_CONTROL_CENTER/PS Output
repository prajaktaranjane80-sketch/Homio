>>     )
>>
>>     $endpoint = "repos/$Repo/contents/$Path`?ref=$CommitSha"
>>
>>     $file = Get-GhJson `
>>         -Endpoint $endpoint `
>>         -Jq '{path: .path, sha: .sha, size: .size, encoding: .encoding, content: .content}'
>>
>>     if ($file.encoding -ne "base64" -or [string]::IsNullOrWhiteSpace($file.content)) {
>>         throw "FAIL: Unexpected file response for $Path"
>>     }
>>
>>     $cleanBase64 = [string]$file.content -replace '\s', ''
>>     $bytes = [Convert]::FromBase64String($cleanBase64)
>>     $source = [Text.Encoding]::UTF8.GetString($bytes)
>>
>>     return [pscustomobject]@{
>>         Path    = $file.path
>>         Sha     = $file.sha
>>         Size    = $file.size
>>         Content = $source
>>     }
>> }

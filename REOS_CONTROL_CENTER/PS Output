    findings: tuple[RiskRuleFinding, ...]
    evaluated_at: datetime
    schema_version: int = RISK_RULE_SCHEMA_VERSION
    model_version: str = RISK_RULE_MODEL_VERSION
    source_of_truth: str = "risk_rule_evaluation"

    def __post_init__(self) -> None:
        _uuid(self.assessment_id, "assessment_id")
        object.__setattr__(
            self,
            "tenant_id",
            _text(self.tenant_id, "tenant_id"),
        )
        object.__setattr__(
            self,
            "subject_id",
            _text(self.subject_id, "subject_id"),
        )
        object.__setattr__(
            self,
            "action_id",
            _text(self.action_id, "action_id"),
        )
        object.__setattr__(
            self,
            "rule_set_version",
            _text(
                self.rule_set_version,
                "rule_set_version",
            ),
        )
        object.__setattr__(
            self,
            "rule_set_fingerprint",
            _text(
                self.rule_set_fingerprint,
                "rule_set_fingerprint",
            ),
        )

        if (
            isinstance(self.total_score, bool)
            or not isinstance(self.total_score, int)
            or not 0 <= self.total_score <= 100
        ):
            raise RiskRuleValidationError(
                "total_score must be integer between 0 and 100"
            )

        if not isinstance(self.level, RiskLevel):
            raise RiskRuleValidationError(
                "level must be RiskLevel"
            )

        matched = tuple(
            _text(rule_id, "matched_rule_id")
            for rule_id in self.matched_rule_ids
        )

        object.__setattr__(
            self,
            "matched_rule_ids",
            tuple(sorted(set(matched))),
        )

        if not isinstance(self.findings, tuple):
            raise RiskRuleValidationError(
                "findings must be tuple"
            )

        for finding in self.findings:
            if not isinstance(
                finding,
                RiskRuleFinding,
            ):
                raise RiskRuleValidationError(
                    "findings must contain RiskRuleFinding"
                )

        object.__setattr__(
            self,
            "evaluated_at",
            _time(self.evaluated_at, "evaluated_at"),
        )

        if self.schema_version != RISK_RULE_SCHEMA_VERSION:
            raise RiskRuleValidationError(
                "Unsupported risk-rule schema version"
            )

        if self.source_of_truth != "risk_rule_evaluation":
            raise RiskRuleValidationError(
                "Invalid risk-rule source_of_truth"
            )

        if (
            any(
                finding.rule_id
                not in self.matched_rule_ids
                for finding in self.findings
            )
        ):
            raise RiskRuleValidationError(
                "Finding rule IDs must be in matched_rule_ids"
            )

    @property
    def identity_key(self) -> tuple[str, str, str]:
        return (
            self.tenant_id,
            self.subject_id,
            self.action_id,
        )

    @property
    def fingerprint(self) -> str:
        return _fingerprint(
            {
                "tenant_id": self.tenant_id,
                "subject_id": self.subject_id,
                "action_id": self.action_id,
                "rule_set_version": self.rule_set_version,
                "rule_set_fingerprint": (
                    self.rule_set_fingerprint
                ),
                "total_score": self.total_score,
                "level": self.level.name,
                "matched_rule_ids": self.matched_rule_ids,
                "findings": tuple(
                    finding.fingerprint
                    for finding in self.findings
                ),
                "schema_version": self.schema_version,
                "model_version": self.model_version,
                "source_of_truth": self.source_of_truth,
            }
        )

    def assert_compatible(
        self,
        other: "RiskAssessment",
    ) -> None:
        if not isinstance(
            other,
            RiskAssessment,
        ):
            raise RiskRuleValidationError(
                "other must be RiskAssessment"
            )

        if self.identity_key != other.identity_key:
            raise RiskRuleConflictError(
                "Risk assessment identities differ"
            )

        if self.fingerprint != other.fingerprint:
            raise RiskRuleConflictError(
                "Same risk assessment identity has conflicting data"
            )

    def to_dict(self) -> dict[str, object]:
        return {
            "assessment_id": str(self.assessment_id),
            "tenant_id": self.tenant_id,
            "subject_id": self.subject_id,
            "action_id": self.action_id,
            "rule_set_version": self.rule_set_version,
            "rule_set_fingerprint": (
                self.rule_set_fingerprint
            ),
            "total_score": self.total_score,
            "level": self.level.name,
            "matched_rule_ids": list(
                self.matched_rule_ids
            ),
            "findings": [
                finding.to_dict()
                for finding in self.findings
            ],
            "evaluated_at": self.evaluated_at.isoformat(),
            "schema_version": self.schema_version,
            "model_version": self.model_version,
            "source_of_truth": self.source_of_truth,
            "fingerprint": self.fingerprint,
        }


class RiskRuleEngine:
    """Deterministic CORE-007 risk-rule evaluator."""

    def evaluate(
        self,
        *,
        context: RiskEvaluationContext,
        ruleset: RiskRuleSet | None = None,
        assessment_id: UUID | None = None,
        evaluated_at: datetime | None = None,
    ) -> RiskAssessment:
        if not isinstance(
            context,
            RiskEvaluationContext,
        ):
            raise RiskRuleValidationError(
                "context must be RiskEvaluationContext"
            )

        ruleset = ruleset or RiskRuleSet.default()

        if not isinstance(
            ruleset,
            RiskRuleSet,
        ):
            raise RiskRuleValidationError(
                "ruleset must be RiskRuleSet"
            )

        findings: list[RiskRuleFinding] = []

        for rule in sorted(
            ruleset.rules,
            key=lambda item: item.rule_id,
        ):
            matched, evidence = rule.matches(context)

            if not matched:
                continue

            findings.append(
                RiskRuleFinding(
                    rule_id=rule.rule_id,
                    rule_version=rule.version,
                    level=rule.level,
                    score_delta=rule.score_weight,
                    reason=rule.description
                    or (
                        f"Risk rule matched: "
                        f"{rule.rule_id}"
                    ),
                    evidence_references=evidence,
                )
            )

        findings = sorted(
            findings,
            key=lambda item: (
                item.rule_id,
                item.rule_version,
                item.level.value,
                item.evidence_references,
            ),
        )

        raw_score = sum(
            finding.score_delta
            for finding in findings
        )

        total_score = min(
            100,
            raw_score,
        )

        level = _score_level(total_score)

        for finding in findings:
            if finding.level > level:
                level = finding.level

        matched_rule_ids = tuple(
            finding.rule_id
            for finding in findings
        )

        return RiskAssessment(

>> class FakeJwksClient:
>>     def __init__(self, public_key, fail: bool = False):
>>         self.public_key = public_key
>>         self.fail = fail
>>         self.calls = 0
>>
>>     def get_signing_key_from_jwt(self, token: str):
>>         self.calls += 1
>>         if self.fail:

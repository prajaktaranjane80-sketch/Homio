>> def mint(private_key, *, algorithm="RS256", **overrides):
>>     now = int(time.time())
>>     claims = {
>>         "iss": ISSUER,
>>         "aud": AUDIENCE,
>>         "sub": "provider-subject-123",
>>         "iat": now,
>>         "exp": now + 300,
>>         "email": "user@example.test",
>>         "email_verified": True,
>>     }
>>     for name, value in overrides.items():
>>         if value is None:
>>             claims.pop(name, None)
>>         else:
>>             claims[name] = value
>>     return jwt.encode(
>>         claims,
>>         private_key,
>>         algorithm=algorithm,
>>         headers={"kid": "test-key"},
>>     )

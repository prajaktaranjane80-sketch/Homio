 773:     def advance_transaction_milestone(
 774:         self,
 775:         target: DealStatus,
 776:         *,
 777:         tenant_id: str,
 778:         expected_version: int,
 779:         reference_id: str | None = None,
 780:         at: str | None = None,
 781:     ) -> "Deal":
 782:         """Advance the canonical Deal lifecycle and append one milestone."""
 783:         self._assert_tenant(tenant_id)
 784:         self._assert_version(expected_version)
 785:
 786:         target = DealStatus(target)
 787:
 788:         transaction_statuses = {
 789:             DealStatus.BOOKING_PENDING,
 790:             DealStatus.BOOKED,
 791:             DealStatus.AGREEMENT_PENDING,
 792:             DealStatus.AGREED,
 793:             DealStatus.REGISTRATION_PENDING,
 794:             DealStatus.REGISTERED,
 795:             DealStatus.COMPLETION_PENDING,
 796:             DealStatus.COMPLETED,
 797:         }
 798:
 799:         if target not in transaction_statuses:
 800:             raise DealTransitionError(
 801:                 f"{target.value} is not a transaction milestone."
 802:             )
 803:
 804:         updated = self.transition(
 805:             target,
 806:             tenant_id=tenant_id,
 807:             expected_version=expected_version,
 808:             at=at,
 809:         )
 810:
 811:         timestamp = (
 812:             datetime.fromisoformat(updated.updated_at)
 813:             if isinstance(updated.updated_at, str)
 814:             else updated.updated_at
 815:         )
 816:
 817:         milestone = DealTransactionMilestone(
 818:             milestone_id=str(uuid4()),
 819:             deal_id=self.deal_id,
 820:             tenant_id=self.tenant_id,
 821:             from_status=self.status,
 822:             to_status=target,
 823:             sequence=len(self.milestones) + 1,
 824:             deal_version=updated.version,
 825:             occurred_at=timestamp,
 826:             reference_id=reference_id,
 827:         )
 828:
 829:         return replace(
 830:             updated,
 831:             milestones=self.milestones + (milestone,),
 832:         )
